    echo -e "${BOLD}PASSWORD ATTACKS${RESET}"
    echo "  hashcat       - GPU-accelerated password cracker"
    echo "  john          - CPU-based password cracker (John the Ripper)"
    echo "  medusa        - Network login brute-forcer"
    echo "  cewl          - Website wordlist generator"
    echo "  crunch        - Custom wordlist generator"
    echo ""
  }

  show_web() {
    echo -e "${BOLD}WEB TESTING${RESET}"
    echo "  burpsuite     - Web proxy and scanner"
    echo "  gobuster      - Directory/file/DNS/vhost brute-forcer"
    echo "  ffuf          - Fast web fuzzer"
    echo "  feroxbuster   - Recursive web content discovery"
    echo "  nikto         - Web server scanner"
    echo "  wfuzz         - Web application fuzzer"
    echo ""
  }

  case "${category}" in
    recon)       show_recon ;;
    exploitation) show_exploitation ;;
    post)        show_post ;;
    password)    show_password ;;
    web)         show_web ;;
    all|*)
      show_recon
      show_exploitation
      show_post
      show_password
      show_web
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
cmd_note() {
  local action="${1:-list}"
  local title="${2:-}"

  case "${action}" in
    new)
      if [[ -z "${title}" ]]; then
        read -rp "Note title: " title
      fi
      local filename="${NOTES_DIR}/$(echo "${title}" | tr ' ' '_' | tr '[:upper:]' '[:lower:]').md"
      local editor="${EDITOR:-nano}"
      cat > "${filename}" <<EOF
# ${title}
Date: $(date '+%Y-%m-%d %H:%M')
Target:
IP:

---

## Summary


## Commands Used


## Findings


## Credentials Found


## Next Steps

EOF
      ${editor} "${filename}"
      success "Note saved: ${filename}"
      ;;

    list)
      header "Study Notes"
      if ls "${NOTES_DIR}"/*.md &>/dev/null; then
        ls -1 "${NOTES_DIR}"/*.md | while read -r f; do
          echo "  $(basename "${f}")"
        done
      else
        info "No notes yet. Create one with: ${SCRIPT_NAME} note new 'Title'"
      fi
      ;;

    view)
      if [[ -z "${title}" ]]; then
        error "Specify note title (partial match ok)."
        exit 1
      fi
      local match
      match=$(find "${NOTES_DIR}" -name "*${title}*" -type f | head -1)
      if [[ -n "${match}" ]]; then
        cat "${match}"
      else
        error "No note found matching: ${title}"
        exit 1
      fi
      ;;

    delete|del)
      if [[ -z "${title}" ]]; then
        error "Specify note title to delete."
        exit 1
      fi
      local match
      match=$(find "${NOTES_DIR}" -name "*${title}*" -type f | head -1)
      if [[ -n "${match}" ]]; then
        rm "${match}"
        success "Deleted: ${match}"
      else
        error "No note found matching: ${title}"
        exit 1
      fi
      ;;

    *)
      error "Unknown note action: ${action}. Use: new | list | view | delete"
      exit 1
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Bookmarks
# ---------------------------------------------------------------------------
cmd_bookmark() {
  local action="${1:-list}"
  local entry="${2:-}"

  case "${action}" in
    add)
      if [[ -z "${entry}" ]]; then
        read -rp "URL or resource: " entry
      fi
      echo "${entry}" >> "${BOOKMARKS_FILE}"
      success "Bookmark saved."
      ;;
    list)
      header "Resource Bookmarks"
      if [[ -s "${BOOKMARKS_FILE}" ]]; then
        nl -ba "${BOOKMARKS_FILE}"
      else
        info "No bookmarks yet. Add with: ${SCRIPT_NAME} bookmark add <url>"
      fi
      ;;
    del|delete)
      if [[ -z "${entry}" ]]; then
        read -rp "Line number to delete: " entry
      fi
      sed -i "${entry}d" "${BOOKMARKS_FILE}"
      success "Bookmark deleted."
      ;;
    *)
      error "Unknown bookmark action: ${action}. Use: add | list | del"
      exit 1
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Lab tracker
# ---------------------------------------------------------------------------
cmd_lab() {
  local action="${1:-stats}"
  local ip="${2:-}"
  local note="${3:-}"
  local lab_log="${DATA_DIR}/labs.log"
  touch "${lab_log}"

  case "${action}" in
    pwned)
      if [[ -z "${ip}" ]]; then
        read -rp "Target IP: " ip
        read -rp "Note (exploit/method): " note
      fi
      local ts
      ts=$(date '+%Y-%m-%d %H:%M')
      echo "${ts} | ${ip} | ${note}" >> "${lab_log}"
      python3 -c "
import json
with open('${PROGRESS_FILE}') as f: d = json.load(f)
d['labs_pwned'] = d.get('labs_pwned', 0) + 1
with open('${PROGRESS_FILE}', 'w') as f: json.dump(d, f, indent=2)
"
      success "Lab machine logged: ${ip}"
      ;;

    stats|list)
      header "Lab Machines Pwned"
      if [[ -s "${lab_log}" ]]; then
        echo -e "  ${BOLD}Timestamp            | IP           | Notes${RESET}"
        echo "  ----------------------------------------------------------------"
        while IFS= read -r line; do
          echo "  ${line}"
        done < "${lab_log}"
        echo ""
        echo -e "  ${BOLD}Total:${RESET} $(wc -l < "${lab_log}") machines"
      else
        info "No labs logged yet. Use: ${SCRIPT_NAME} lab pwned <ip> 'exploit note'"
      fi
      ;;

    reset)
      read -rp "Clear all lab records? (yes/no): " confirm
      if [[ "${confirm}" == "yes" ]]; then
        > "${lab_log}"
        python3 -c "
import json
with open('${PROGRESS_FILE}') as f: d = json.load(f)
d['labs_pwned'] = 0
with open('${PROGRESS_FILE}', 'w') as f: json.dump(d, f, indent=2)
"
        warn "Lab records cleared."
      fi
      ;;

    *)
      error "Unknown lab action: ${action}. Use: pwned | stats | reset"
      exit 1
      ;;
  esac
}

