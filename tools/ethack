run_quiz() {
  local score=0
  print_header "Quick Knowledge Quiz" "Test your ethical hacking knowledge"
  center_text "${DIM}Press any key to begin…${RESET}"
  read -rsn1

  local q
  for (( q=1; q<=TOTAL_QUESTIONS; q++ )); do
    print_header "Quiz  (${q}/${TOTAL_QUESTIONS})" "${Q_TEXT[$q]}"
    printf "\n"
    center_text "  ${BWHITE}1)${RESET} ${Q_A[$q]}"
    center_text "  ${BWHITE}2)${RESET} ${Q_B[$q]}"
    center_text "  ${BWHITE}3)${RESET} ${Q_C[$q]}"
    center_text "  ${BWHITE}4)${RESET} ${Q_D[$q]}"
    printf "\n"
    center_text "${DIM}Press 1-4 to answer · q to quit quiz${RESET}"
    printf "\n"

    local answered=false
    while ! $answered; do
      read_key
      case "$KEY" in
        q|Q|"ESC") return ;;
        [1-4])
          answered=true
          if [[ "$KEY" == "${Q_ANS[$q]}" ]]; then
            print_header "Quiz  (${q}/${TOTAL_QUESTIONS})" "${Q_TEXT[$q]}"
            printf "\n"
            center_text "${BGREEN}✓  Correct!${RESET}"
            (( score++ )) || true
          else
            local correct_label_var="Q_${Q_ANS[$q]}"
            print_header "Quiz  (${q}/${TOTAL_QUESTIONS})" "${Q_TEXT[$q]}"
            printf "\n"
            center_text "${BRED}✗  Incorrect${RESET}"
          fi
          printf "\n"
          center_text "${BYELLOW}Explanation:${RESET}"
          printf "\n"
          center_text "${Q_EXPLAIN[$q]}"
          printf "\n"
          center_text "${DIM}Press any key to continue…${RESET}"
          read -rsn1 ;;
      esac
    done
  done

  # Results
  print_header "Quiz Complete!" "Results"
  printf "\n"
  local pct=$(( score * 100 / TOTAL_QUESTIONS ))
  local grade
  if   (( pct >= 90 )); then grade="${BGREEN}Expert${RESET}"
  elif (( pct >= 70 )); then grade="${BCYAN}Proficient${RESET}"
  elif (( pct >= 50 )); then grade="${BYELLOW}Developing${RESET}"
  else                       grade="${BRED}Keep Studying${RESET}"
  fi

  center_text "Score: ${BWHITE}${score} / ${TOTAL_QUESTIONS}${RESET}   (${pct}%)"
  printf "\n"
  center_text "Grade: ${grade}"
  printf "\n"
  center_text "${DIM}Press any key to return to menu…${RESET}"
  read -rsn1
}

