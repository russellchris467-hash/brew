# ---------------------------------------------------------------------------
# Progress tracker
# ---------------------------------------------------------------------------
cmd_progress() {
  local action="${1:-show}"

  header "OSCP Module Progress"

  declare -A labels=(
    [recon]="Reconnaissance"
    [scanning]="Scanning & Port Enumeration"
    [enumeration]="Service Enumeration"
    [exploitation]="Exploitation Techniques"
    [post_exploit]="Post-Exploitation"
    [privesc_lin]="Linux Privilege Escalation"
    [privesc_win]="Windows Privilege Escalation"
    [pivoting]="Pivoting & Tunneling"
    [reporting]="Report Writing"
    [buffer_over]="Buffer Overflow"
  )

  local modules=("recon" "scanning" "enumeration" "exploitation" "post_exploit"
                 "privesc_lin" "privesc_win" "pivoting" "reporting" "buffer_over")
  local total=${#modules[@]}
  local done_count=0

  if [[ "${action}" == "show" ]]; then
    for m in "${modules[@]}"; do
      local val
      val=$(python3 -c "import json,sys; d=json.load(open('${PROGRESS_FILE}')); print(d['modules']['${m}'])" 2>/dev/null || echo "False")
      if [[ "${val}" == "True" ]]; then
        echo -e "  ${GREEN}[✓]${RESET} ${labels[$m]}"
        ((done_count++)) || true
      else
        echo -e "  ${RED}[ ]${RESET} ${labels[$m]}"
      fi
    done

    local labs
    labs=$(python3 -c "import json; d=json.load(open('${PROGRESS_FILE}')); print(d['labs_pwned'])" 2>/dev/null || echo "0")
    echo ""
    echo -e "  ${BOLD}Modules completed:${RESET} ${done_count}/${total}"
    echo -e "  ${BOLD}Lab machines pwned:${RESET} ${labs}"

    local pct=$(( done_count * 100 / total ))
    local bar=""
    for (( i=0; i<20; i++ )); do
      if (( i < pct / 5 )); then bar+="#"; else bar+="-"; fi
    done
    echo -e "\n  Progress: [${GREEN}${bar}${RESET}] ${pct}%\n"

  elif [[ "${action}" == "complete" ]]; then
    echo "Which module did you complete?"
    local i=1
    for m in "${modules[@]}"; do
      echo "  $i) ${labels[$m]}"
      ((i++))
    done
    read -rp "Enter number: " choice
    local idx=$(( choice - 1 ))
    local mod="${modules[$idx]}"
    python3 -c "
import json
with open('${PROGRESS_FILE}') as f: d = json.load(f)
d['modules']['${mod}'] = True
with open('${PROGRESS_FILE}', 'w') as f: json.dump(d, f, indent=2)
print('Marked ${mod} as complete!')
"
    success "Module marked complete."

  elif [[ "${action}" == "reset" ]]; then
    read -rp "Reset ALL progress? (yes/no): " confirm
    if [[ "${confirm}" == "yes" ]]; then
      rm -f "${PROGRESS_FILE}"
      init_data_dir
      warn "Progress reset."
    fi
  else
    error "Unknown progress action: ${action}. Use: show | complete | reset"
    exit 1
  fi
}

