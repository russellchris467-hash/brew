# ─────────────────────────────────────────────────────────────────────────────
# COLORS & TERMINAL
# ─────────────────────────────────────────────────────────────────────────────
RED=$'\033[0;31m';    BRED=$'\033[1;31m'
GREEN=$'\033[0;32m';  BGREEN=$'\033[1;32m'
YELLOW=$'\033[1;33m'; BYELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m';   BBLUE=$'\033[1;34m'
CYAN=$'\033[0;36m';   BCYAN=$'\033[1;36m'
MAGENTA=$'\033[0;35m';BMAGENTA=$'\033[1;35m'
WHITE=$'\033[0;37m';  BWHITE=$'\033[1;37m'
DIM=$'\033[2m';       BOLD=$'\033[1m'
RESET=$'\033[0m'

COLS=$(tput cols 2>/dev/null || echo 80)
ROWS=$(tput lines 2>/dev/null || echo 24)

hide_cursor()   { tput civis 2>/dev/null || true; }
show_cursor()   { tput cnorm 2>/dev/null || true; }
clear_screen()  { printf '\033[2J\033[H'; }
move_to()       { printf '\033[%d;%dH' "$1" "$2"; }
save_pos()      { printf '\033[s'; }
restore_pos()   { printf '\033[u'; }

# On exit, restore terminal
cleanup() {
  show_cursor
  tput rmcup 2>/dev/null || true
  echo ""
}
trap cleanup EXIT INT TERM

# ─────────────────────────────────────────────────────────────────────────────
# HELPERS
# ─────────────────────────────────────────────────────────────────────────────
center_text() {
  local text="$1" width="${2:-${COLS}}"
  # strip color codes for length calculation
  local plain; plain=$(echo "$text" | sed 's/\x1b\[[0-9;]*m//g')
  local len=${#plain}
  local pad=$(( (width - len) / 2 ))
  printf "%*s%s\n" "$pad" "" "$text"
}

hline() {
  local char="${1:─}" width="${2:-${COLS}}"
  printf '%*s\n' "$width" '' | tr ' ' "${char}"
}

hline_color() {
  local char="${1}" color="${2}" width="${3:-${COLS}}"
  printf "${color}"
  printf '%*s' "$width" '' | tr ' ' "${char}"
  printf "${RESET}\n"
}

draw_box() {
  # draw_box <row> <col> <height> <width> <color>
  local row=$1 col=$2 h=$3 w=$4 color="${5:-$CYAN}"
  local i
  move_to $row $col; printf "${color}┌"; printf '─%.0s' $(seq 1 $((w-2))); printf "┐${RESET}"
  for (( i=1; i<h-1; i++ )); do
    move_to $((row+i)) $col; printf "${color}│${RESET}"; printf '%*s' $((w-2)) ''; printf "${color}│${RESET}"
  done
  move_to $((row+h-1)) $col; printf "${color}└"; printf '─%.0s' $(seq 1 $((w-2))); printf "┘${RESET}"
}

print_header() {
  local title="${1}" subtitle="${2:-}"
  clear_screen
  printf "\n"
  center_text "${BBLUE}╔══════════════════════════════════════════════════════════════╗${RESET}"
  center_text "${BBLUE}║${RESET}  ${BRED}▓▒░${RESET} ${BWHITE}ETHACK${RESET} ${CYAN}─ Interactive Ethical Hacking Trainer${RESET}  ${BRED}░▒▓${RESET}  ${BBLUE}║${RESET}"
  center_text "${BBLUE}╚══════════════════════════════════════════════════════════════╝${RESET}"
  if [[ -n "$title" ]]; then
    printf "\n"
    center_text "${BYELLOW}◈  ${BWHITE}${title}${RESET}  ${BYELLOW}◈${RESET}"
    [[ -n "$subtitle" ]] && center_text "${DIM}${subtitle}${RESET}"
  fi
  printf "\n"
}

# Read a single keypress, including arrow keys
# Sets global KEY variable
read_key() {
  local k1 k2 k3
  IFS= read -rsn1 k1
  KEY="$k1"
  if [[ "$k1" == $'\x1b' ]]; then
    IFS= read -rsn1 -t 0.1 k2 || true
    if [[ "$k2" == '[' ]]; then
      IFS= read -rsn1 -t 0.1 k3 || true
      KEY="ESC[${k3}"
    elif [[ -z "$k2" ]]; then
      KEY="ESC"
    fi
  fi
}

# ─────────────────────────────────────────────────────────────────────────────
# INTERACTIVE MENU ENGINE
# Returns selected index in global MENU_RESULT (0-based)
# Returns -1 if user pressed Back/Quit
# ─────────────────────────────────────────────────────────────────────────────
interactive_menu() {
  local title="$1"
  local subtitle="$2"
  shift 2
  local items=("$@")
  local count=${#items[@]}
  local selected=0

  hide_cursor
  while true; do
    print_header "$title" "$subtitle"

    local i
    for (( i=0; i<count; i++ )); do
      local prefix icon label
      # Extract icon prefix if present (format: "ICON|Label")
      if [[ "${items[$i]}" == *"|"* ]]; then
        icon="${items[$i]%%|*}"
        label="${items[$i]#*|}"
      else
        icon="  "
        label="${items[$i]}"
      fi

      if (( i == selected )); then
        center_text "  ${BBLUE}▶${RESET} ${BWHITE}${icon}${RESET} ${BGREEN}${label}${RESET}  ${BBLUE}◀${RESET}"
      else
        center_text "    ${CYAN}${icon}${RESET} ${WHITE}${label}${RESET}"
      fi
    done

    printf "\n"
    center_text "${DIM}↑↓ navigate  ·  Enter select  ·  q / ESC back${RESET}"
    printf "\n"

    read_key

    case "$KEY" in
      "ESC[A"|$'\x1b'[A)   # Up arrow
        (( selected = (selected - 1 + count) % count )) ;;
      "ESC[B"|$'\x1b'[B)   # Down arrow
        (( selected = (selected + 1) % count )) ;;
      ""|$'\n'|$'\r')  # Enter
        MENU_RESULT=$selected
        return 0 ;;
      [0-9])  # Number shortcut
        local n=$(( KEY - 1 ))
        if (( n >= 0 && n < count )); then
          MENU_RESULT=$n
          return 0
        fi ;;
      q|Q|"ESC"|$'\x7f'|$'\x08')  # q, ESC, backspace
        MENU_RESULT=-1
        return 0 ;;
    esac
  done
}

# ─────────────────────────────────────────────────────────────────────────────
# PAGER - display text content with scroll support
# ─────────────────────────────────────────────────────────────────────────────
pager() {
  local title="$1"; shift
  local lines=("$@")
  local total=${#lines[@]}
  local visible=$(( ROWS - 8 ))
  (( visible < 5 )) && visible=5
  local offset=0

  hide_cursor
  while true; do
    print_header "$title"
    hline_color "─" "${DIM}" "$COLS"

    local i end=$(( offset + visible ))
    (( end > total )) && end=$total
    for (( i=offset; i<end; i++ )); do
      printf "  %s\n" "${lines[$i]}"
    done

    # Fill remaining lines
    local shown=$(( end - offset ))
    local fill=$(( visible - shown ))
    for (( i=0; i<fill; i++ )); do printf "\n"; done

    hline_color "─" "${DIM}" "$COLS"
    local pct=0
    (( total > 0 )) && pct=$(( (offset + visible) * 100 / total ))
    (( pct > 100 )) && pct=100
    center_text "${DIM}↑↓/PgUp/PgDn scroll  ·  q / ESC back  ·  ${pct}%  ($(( offset+1 ))–${end}/${total})${RESET}"

    read_key
    case "$KEY" in
      "ESC[A"|k)  (( offset > 0 )) && (( offset-- )) ;;
      "ESC[B"|j)  (( offset + visible < total )) && (( offset++ )) ;;
      "ESC[5")  # PgUp
        (( offset -= visible )); (( offset < 0 )) && offset=0 ;;
      "ESC[6")  # PgDn
        (( offset += visible ))
        (( offset + visible > total )) && offset=$(( total - visible ))
        (( offset < 0 )) && offset=0 ;;
      g|"ESC[H")  offset=0 ;;
      "G"|"ESC[F")  offset=$(( total - visible )); (( offset < 0 )) && offset=0 ;;
      q|Q|"ESC"|$'\x7f'|$'\x08') return ;;
    esac
  done
}

# Helper: run pager with a heredoc string
show_content() {
  local title="$1" content="$2"
  local -a lines
  while IFS= read -r line; do
    lines+=("$line")
  done <<< "$content"
  pager "$title" "${lines[@]}"
}

# ─────────────────────────────────────────────────────────────────────────────
# PROGRESS
# ─────────────────────────────────────────────────────────────────────────────
get_progress_val() {
  python3 -c "
import json, sys
try:
    d = json.load(open('${PROGRESS_FILE}'))
    print(d['modules'].get('$1', False))
except: print('False')
" 2>/dev/null
}

set_progress_val() {
  python3 -c "
import json
d = json.load(open('${PROGRESS_FILE}'))
d['modules']['$1'] = $2
json.dump(d, open('${PROGRESS_FILE}','w'), indent=2)
" 2>/dev/null
}

get_labs() {
  python3 -c "import json; d=json.load(open('${PROGRESS_FILE}')); print(d.get('labs',0))" 2>/dev/null || echo "0"
}

inc_labs() {
  python3 -c "
import json
d = json.load(open('${PROGRESS_FILE}'))
d['labs'] = d.get('labs',0) + 1
json.dump(d, open('${PROGRESS_FILE}','w'), indent=2)
" 2>/dev/null
}

show_progress_screen() {
  local modules=("recon" "scanning" "web" "network" "exploitation" "post"
                 "privesc_lin" "privesc_win" "password" "pivoting" "bufferoverflow" "reporting")
  local labels=("Reconnaissance" "Scanning & Enumeration" "Web Attacks" "Network Attacks"
                "Exploitation" "Post-Exploitation" "Linux Privilege Escalation"
                "Windows Privilege Escalation" "Password Attacks" "Pivoting & Tunneling"
                "Buffer Overflow" "Report Writing")
  local total=${#modules[@]}
  local done_count=0
  local -a status_vals

  for m in "${modules[@]}"; do
    local v; v=$(get_progress_val "$m")
    status_vals+=("$v")
    [[ "$v" == "True" ]] && (( done_count++ )) || true
  done

  local labs; labs=$(get_labs)
  local pct=0
  (( total > 0 )) && pct=$(( done_count * 100 / total ))

  print_header "Training Progress" "Track your OSCP module completion"

  local i
  for (( i=0; i<total; i++ )); do
    local col row_label
    row_label="${labels[$i]}"
    if [[ "${status_vals[$i]}" == "True" ]]; then
      col="${BGREEN}"
      center_text "  ${BGREEN}[✓]${RESET} ${col}${row_label}${RESET}"
    else
      center_text "  ${RED}[ ]${RESET} ${WHITE}${row_label}${RESET}"
    fi
  done

  printf "\n"
  # Progress bar
  local bar="" filled=$(( pct / 5 ))
  for (( i=0; i<20; i++ )); do
    if (( i < filled )); then bar+="${BGREEN}█${RESET}"; else bar+="${DIM}░${RESET}"; fi
  done
  center_text "Progress: [${bar}] ${BYELLOW}${pct}%${RESET}  (${done_count}/${total} modules)"
  center_text "${BCYAN}Labs pwned: ${BWHITE}${labs}${RESET}"

  printf "\n"
  center_text "${DIM}Press m to mark a module complete · q to go back${RESET}"
  printf "\n"

  while true; do
    read_key
    case "$KEY" in
      m|M)
        # Pick a module to mark
        local menu_items=()
        for (( i=0; i<total; i++ )); do
          local tick=""
          [[ "${status_vals[$i]}" == "True" ]] && tick=" ✓"
          menu_items+=("${labels[$i]}${tick}")
        done
        interactive_menu "Mark Module Complete" "Select a module to toggle" "${menu_items[@]}"
        if (( MENU_RESULT >= 0 )); then
          local mod="${modules[$MENU_RESULT]}"
          local cur; cur=$(get_progress_val "$mod")
          if [[ "$cur" == "True" ]]; then
            set_progress_val "$mod" "False"
          else
            set_progress_val "$mod" "True"
          fi
        fi
        show_progress_screen
        return ;;
      q|Q|"ESC"|$'\x7f') return ;;
    esac
  done
}

