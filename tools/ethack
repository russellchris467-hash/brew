          sleep 1.5
        fi ;;
      2)  # View
        print_header "View Note"
        show_cursor
        read -rp "  Search term: " term
        hide_cursor
        [[ -z "$term" ]] && continue
        local match; match=$(find "${NOTES_DIR}" -name "*${term}*" -type f | head -1)
        if [[ -n "$match" ]]; then
          local -a lns=()
          while IFS= read -r line; do lns+=("$line"); done < "$match"
          pager "$(basename "$match")" "${lns[@]}"
        else
          print_header "View Note"
          center_text "${BRED}No note found matching: ${term}${RESET}"
          sleep 1.5
        fi ;;
      3)  # Delete
        print_header "Delete Note"
        show_cursor
        read -rp "  Search term: " term
        hide_cursor
        [[ -z "$term" ]] && continue
        local match; match=$(find "${NOTES_DIR}" -name "*${term}*" -type f | head -1)
        if [[ -n "$match" ]]; then
          show_cursor
          read -rp "  Delete $(basename "$match")? (yes/no): " conf
          hide_cursor
          [[ "$conf" == "yes" ]] && rm "$match" && \
            center_text "${BGREEN}Deleted.${RESET}" && sleep 1
        else
          center_text "${BRED}No note found.${RESET}"; sleep 1.5
        fi ;;
    esac
  done
}

