# [CORE] System essentials
# ---------------------------------------------------------------------------
bash
zsh
tmux
vim
nano
curl
wget
git
make
gcc
python3
python3-pip
python3-venv
ruby
perl
net-tools
iproute2
iputils-ping
dnsutils
whois
traceroute
tcpdump
tshark
socat
ncat
netcat-openbsd
openssh-client
openssl
ca-certificates
gnupg2
sudo
less
file
binutils
gdb
strace
ltrace
lsof

