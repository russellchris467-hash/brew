#!/usr/bin/env bash
# oscp-trainer - OSCP & Security Research/Development Training CLI Tool
# A structured reference and progress tracker for OSCP certification study

set -euo pipefail

VERSION="1.0.0"
SCRIPT_NAME="oscp-trainer"
DATA_DIR="${HOME}/.oscp-trainer"
NOTES_DIR="${DATA_DIR}/notes"
PROGRESS_FILE="${DATA_DIR}/progress.json"
BOOKMARKS_FILE="${DATA_DIR}/bookmarks.txt"

# ---------------------------------------------------------------------------
# Colors
# ---------------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
info()    { echo -e "${CYAN}[INFO]${RESET}  $*"; }
success() { echo -e "${GREEN}[OK]${RESET}    $*"; }
warn()    { echo -e "${YELLOW}[WARN]${RESET}  $*"; }
error()   { echo -e "${RED}[ERROR]${RESET} $*" >&2; }
header()  { echo -e "\n${BOLD}${BLUE}=== $* ===${RESET}\n"; }

init_data_dir() {
  mkdir -p "${DATA_DIR}" "${NOTES_DIR}"
  if [[ ! -f "${PROGRESS_FILE}" ]]; then
    cat > "${PROGRESS_FILE}" <<'EOF'
{
  "modules": {
    "recon":       false,
    "scanning":    false,
    "enumeration": false,
    "exploitation":false,
    "post_exploit":false,
    "privesc_lin": false,
    "privesc_win": false,
    "pivoting":    false,
    "reporting":   false,
    "buffer_over": false
  },
  "labs_pwned": 0,
  "completed": false
}
EOF
  fi
  if [[ ! -f "${BOOKMARKS_FILE}" ]]; then
    touch "${BOOKMARKS_FILE}"
  fi
}

