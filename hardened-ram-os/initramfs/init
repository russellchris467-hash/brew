#!/bin/sh
# =============================================================================
# init — Amnesiac RAM-OS early userspace init
# =============================================================================
# This script runs as PID 1 inside the initramfs.  It:
#   1. Mounts essential pseudo-filesystems
#   2. Finds the squashfs live image on boot media (USB/CD)
#   3. Loads the squashfs into RAM via a tmpfs copy (full RAM load)
#   4. Mounts the squashfs read-only with a tmpfs overlay (OverlayFS)
#   5. Switches root into the overlay — all writes go to RAM
#   6. Registers a shutdown hook that zero-wipes all tmpfs pages
# =============================================================================
set -e

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
NEWROOT=/newroot
SQUASH_MNT=/squash_ro
OVERLAY_WORK=/overlay_work
OVERLAY_UPPER=/overlay_rw
LIVE_IMAGE_NAME="filesystem.squashfs"
WIPE_PASSES=3

# ---------------------------------------------------------------------------
# Early mounts
# ---------------------------------------------------------------------------
mount -t proc     proc    /proc
mount -t sysfs    sysfs   /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs    tmpfs   /run
mkdir -p /dev/pts
mount -t devpts   devpts  /dev/pts

# Kernel messages: suppress verbose output
echo 3 > /proc/sys/kernel/printk

# ---------------------------------------------------------------------------
# Helper: log with timestamp
# ---------------------------------------------------------------------------
log() {
    # FIND-20 FIX: /proc/uptime may not exist on all early-boot configurations.
    # Guard the read so log() works even before /proc is fully populated.
    if [ -r /proc/uptime ]; then
        echo "[$(cut -d' ' -f1 /proc/uptime)] $*"
    else
        echo "[boot] $*"
    fi
}

# ---------------------------------------------------------------------------
# Entropy gathering (critical before crypto operations)
# ---------------------------------------------------------------------------
log "Gathering entropy from hardware..."
if [ -c /dev/hwrng ]; then
    dd if=/dev/hwrng of=/dev/random bs=512 count=4 2>/dev/null || true
fi
# Stir the pool with CPU jitter
dd if=/proc/interrupts of=/dev/random bs=1024 count=1 2>/dev/null || true
dd if=/proc/sys/kernel/random/uuid of=/dev/random bs=1 count=36 2>/dev/null || true
log "Entropy pool seeded"

# ---------------------------------------------------------------------------
# Parse kernel command line
# ---------------------------------------------------------------------------
BOOT_LABEL=""
BOOT_UUID=""
TORAM=1          # Default: always copy to RAM
QUIET=0
FORENSIC=0       # If 1: do NOT mount anything automatically (forensic mode)

for param in $(cat /proc/cmdline); do
    case "$param" in
        boot=label:*) BOOT_LABEL="${param#boot=label:}" ;;
        boot=UUID:*)  BOOT_UUID="${param#boot=UUID:}" ;;
        toram=0)      TORAM=0 ;;
        quiet)        QUIET=1 ;;
        forensic)     FORENSIC=1 ;;
    esac
done

if [ "$FORENSIC" = "1" ]; then
    log "FORENSIC MODE: no auto-mount of local disks"
fi

# ---------------------------------------------------------------------------
# Wait for boot device to appear
# ---------------------------------------------------------------------------
log "Scanning for boot media..."
BOOT_DEV=""
SQUASH_SRC=""

find_boot_device() {
    local attempts=0
    # FIX(MEDIUM): PID 1 always has $$ == 1 inside initramfs, so /mnt/scan_$$
    # always expanded to /mnt/scan_1.  On retry loops the rmdir would fail (still
    # mounted from a previous attempt), and a second mount call to the same path
    # while the first mount was still active could shadow or corrupt the source path.
    # Now we use a fixed scan mount point and always ensure it is unmounted first.
    local mnt="/mnt/scan_boot"
    mkdir -p "$mnt"

    while [ $attempts -lt 30 ]; do
        for dev in /dev/sd* /dev/sr* /dev/mmcblk* /dev/nvme*n*; do
            [ -b "$dev" ] || continue
            # Skip mounted devices if forensic mode
            # BUG-10 FIX: grep -q without -F treats the device path as a regex.
            # Characters like '+' in device names (e.g. /dev/mmcblk0p1+) would be
            # regex metacharacters, causing false-positive or false-negative matches.
            if [ "$FORENSIC" = "1" ] && grep -qF "${dev} " /proc/mounts 2>/dev/null; then
                continue
            fi

            # FIND-8 FIX: Plain `umount` fails if anything still holds the mount
            # point open (e.g. a background find still traversing it), leaving the
            # device mounted and the next attempt silently mount-stacking on top.
            # `umount -l` (lazy) marks the mount for release once all file handles
            # close, guaranteeing the path is free for the next iteration.
            umount -l "$mnt" 2>/dev/null || true

            if mount -o ro "$dev" "$mnt" 2>/dev/null; then
                if [ -f "${mnt}/live/${LIVE_IMAGE_NAME}" ]; then
                    BOOT_DEV="$dev"
                    SQUASH_SRC="${mnt}/live/${LIVE_IMAGE_NAME}"
                    log "Found live image on ${dev}"
                    return 0
                fi
                umount "$mnt" 2>/dev/null || true
            fi
        done
        attempts=$((attempts + 1))
        sleep 1
    done
    return 1
}

# BUG-17 FIX: The previous outer retry loop (`until find_boot_device || 3 tries`)
# was redundant and confusing — find_boot_device() already retries internally for
# up to 30 seconds.  The outer loop added up to 3×30=90 extra seconds of wait
# while the log message said "5s", making diagnostic output misleading.
# Now we call find_boot_device() once (which already does its own polling).
if ! find_boot_device; then
    log "FATAL: Could not find boot device containing ${LIVE_IMAGE_NAME}."
    log "Halting. No shell provided (use GRUB-password-protected debug entry for recovery)."
    # BUG-11 FIX: `sleep 30 && poweroff -f &` uses &&, so if sleep is killed
    # (SIGKILL during early panic), poweroff never runs.  Use semicolon instead.
    (sleep 30; poweroff -f) &
    exec /bin/false
fi

# ---------------------------------------------------------------------------
# Copy squashfs to RAM (toram mode — the amnesiac guarantee)
# ---------------------------------------------------------------------------
# By loading the entire squashfs into a tmpfs file, the boot device can be
# removed and ALL data lives only in volatile DRAM.
# ---------------------------------------------------------------------------

mkdir -p /ram_store
mount -t tmpfs -o size=90%,mode=0700 tmpfs /ram_store

if [ "$TORAM" = "1" ]; then
    log "Copying squashfs to RAM (this may take a moment)..."
    SQUASH_SIZE=$(stat -c%s "$SQUASH_SRC" 2>/dev/null || echo 0)
    log "  Image size: $((SQUASH_SIZE / 1024 / 1024)) MiB"

    # FIND-27 FIX: tmpfs is capped at 90% of RAM.  If the squashfs is larger than
    # available tmpfs space the cp will fail mid-write with a cryptic "No space left
    # on device" error, leaving a partial file that will fail integrity checks.
    # Check available space explicitly and abort with a clear message.
    AVAIL_BYTES=$(df -B1 --output=avail /ram_store 2>/dev/null | tail -1 | tr -d ' ' || echo 0)
    if [ "$SQUASH_SIZE" -gt "$AVAIL_BYTES" ]; then
        log "ERROR: squashfs is $((SQUASH_SIZE / 1024 / 1024)) MiB but only $((AVAIL_BYTES / 1024 / 1024)) MiB available in RAM."
        log "  This system needs more RAM, or build a smaller squashfs image."
        log "  Use toram=0 as a fallback (not fully amnesiac)."
        (sleep 10; poweroff -f) &
        exec /bin/false
    fi

    cp "$SQUASH_SRC" /ram_store/filesystem.squashfs
    ok_src="/ram_store/filesystem.squashfs"

    log "Boot device can now be safely removed"
    # Unmount and release the boot device
    umount /mnt/scan_* 2>/dev/null || true
else
    log "WARNING: toram=0 — squashfs stays on boot device (not fully amnesiac)"
    ok_src="$SQUASH_SRC"
fi

# ---------------------------------------------------------------------------
# Verify squashfs integrity (SHA256)
# ---------------------------------------------------------------------------
# FIND-9 FIX: SQUASH_SRC is a path we constructed via string operations from
# a mount point we control, but the target *filesystem* on that device could
# contain symlinks.  If `filesystem.squashfs` is a symlink to an attacker-
# crafted path, the .sha256 lookup would follow it and verify the wrong hash.
# Resolve to the canonical real path before computing any derived paths.
SQUASH_SRC_REAL=$(readlink -f "$SQUASH_SRC" 2>/dev/null || echo "$SQUASH_SRC")
BOOT_CHKFILE="${SQUASH_SRC_REAL%.squashfs}.sha256"

# FIX(HIGH): Previously booted silently when no checksum file was present.
# An attacker replacing the squashfs but omitting the .sha256 file would bypass
# all integrity verification.  Now we fail closed: no checksum = no boot.
#
# BUG-01 FIX: The previous implementation always verified /ram_store/filesystem.squashfs
# regardless of the toram setting.  When toram=0, the squashfs stays on the boot device
# and is NEVER copied to /ram_store — so sha256sum was checking a non-existent file,
# always failing (or silently succeeding with an empty read depending on the sha256sum
# implementation).  The checksum is now run directly against $ok_src so it works in
# both toram=1 and toram=0 modes.
if [ -f "$BOOT_CHKFILE" ]; then
    log "Verifying squashfs integrity..."
    EXPECTED_HASH=$(cut -d' ' -f1 "$BOOT_CHKFILE")
    ACTUAL_HASH=$(sha256sum "$ok_src" 2>/dev/null | cut -d' ' -f1)
    # Ensure hash string is non-empty and looks like a SHA256 hex digest
    case "$ACTUAL_HASH" in
        [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*) : ;;
        *) ACTUAL_HASH="" ;;
    esac

    if [ -n "$ACTUAL_HASH" ] && [ "$ACTUAL_HASH" = "$EXPECTED_HASH" ]; then
        log "Integrity check PASSED (SHA256: ${ACTUAL_HASH})"
    else
        log "ERROR: Integrity check FAILED"
        log "  Expected: ${EXPECTED_HASH}"
        log "  Actual:   ${ACTUAL_HASH:-<could not compute>}"
        log "Halting. Remove the boot device and investigate."
        (sleep 30; poweroff -f) &
        exec /bin/false
    fi
else
    log "FATAL: No checksum file found at ${BOOT_CHKFILE}"
    log "Boot media must include a .sha256 file alongside the squashfs."
    log "Halting to prevent booting from unverified media."
    (sleep 30; poweroff -f) &
    exec /bin/false
fi

# ---------------------------------------------------------------------------
# Mount squashfs read-only
# ---------------------------------------------------------------------------
log "Mounting squashfs base layer..."
mkdir -p "$SQUASH_MNT"
mount -t squashfs -o loop,ro "$ok_src" "$SQUASH_MNT"

# ---------------------------------------------------------------------------
# Set up OverlayFS with tmpfs upper layer
# ---------------------------------------------------------------------------
# Lower: squashfs (read-only compressed base system)
# Upper: tmpfs   (volatile read-write layer — wiped on shutdown)
# Work:  tmpfs   (overlayfs internal directory)
# ---------------------------------------------------------------------------
log "Setting up amnesiac OverlayFS..."

mkdir -p "$OVERLAY_UPPER" "$OVERLAY_WORK" "$NEWROOT"

# FIND-17 FIX: mode=0755 made the OverlayFS upper layer world-readable,
# allowing any user to inspect another user's modified files via the raw
# tmpfs mount point.  mode=0700 restricts access to root only.
mount -t tmpfs -o size=80%,mode=0700 tmpfs /overlay_rw
mkdir -p "${OVERLAY_UPPER}/upper" "${OVERLAY_UPPER}/work"

mount -t overlay overlay \
    -o "lowerdir=${SQUASH_MNT},upperdir=${OVERLAY_UPPER}/upper,workdir=${OVERLAY_UPPER}/work" \
    "$NEWROOT"

# ---------------------------------------------------------------------------
# Bind-mount pseudo-filesystems into new root
# ---------------------------------------------------------------------------
log "Preparing new root..."
mkdir -p "${NEWROOT}"/{proc,sys,dev,run,tmp}

mount --bind /proc  "${NEWROOT}/proc"
mount --bind /sys   "${NEWROOT}/sys"
mount --bind /dev   "${NEWROOT}/dev"
mount --bind /run   "${NEWROOT}/run"
mount -t tmpfs -o size=512m,mode=1777 tmpfs "${NEWROOT}/tmp"

# ---------------------------------------------------------------------------
# Harden /proc and /sys in the new root
# ---------------------------------------------------------------------------
# Remount proc with hidepid=2 so users can't see each other's processes
mount -o remount,hidepid=2,gid=0 "${NEWROOT}/proc" 2>/dev/null || true

# ---------------------------------------------------------------------------
# Install secure wipe shutdown hook
# ---------------------------------------------------------------------------
# Copy this init script's wipe functionality into the new root as a
# systemd oneshot or SysV shutdown script.
# ---------------------------------------------------------------------------
log "Installing shutdown wipe hooks..."
WIPE_SCRIPT="${NEWROOT}/usr/local/sbin/amnesiac-wipe"

mkdir -p "$(dirname "$WIPE_SCRIPT")"
cat > "$WIPE_SCRIPT" << 'WIPE_EOF'
#!/bin/sh
# amnesiac-wipe — Zero-wipe sensitive RAM content on shutdown
# Called by systemd as a shutdown service (Before=umount.target)
PASSES="${AMNESIAC_WIPE_PASSES:-3}"
log() { echo "[amnesiac-wipe] $*"; logger -t amnesiac-wipe "$*" 2>/dev/null || true; }

# FIND-3 FIX: Without signal handlers the wipe could be interrupted by a
# SIGINT/SIGTERM from an impatient user or from systemd's kill timeout, leaving
# partial data un-wiped in RAM.  Ignore all interruption signals for the
# duration of the wipe so it always runs to completion.
trap '' INT TERM HUP QUIT

# FIND-18 FIX: shred may not be installed on all minimal systems.
# Detect once and set a flag used by wipe_path() below.
HAVE_SHRED=0
command -v shred >/dev/null 2>&1 && HAVE_SHRED=1

log "Initiating secure RAM wipe (${PASSES} passes, shred=${HAVE_SHRED})..."

# Sync all filesystem buffers
sync

# FIX(MEDIUM): "for dir in $UPPER_DIRS" and "for path in $sensitive" were unquoted,
# so shell glob characters in directory names (unlikely but possible via crafted
# filenames) could expand to unexpected paths, wiping the wrong locations or
# skipping intended ones.  Now iterate over explicit lists with IFS control.

# Wipe the OverlayFS upper layer (all writes since boot)
for dir in /overlay_rw/upper /tmp /run /var/tmp; do
    if [ -d "$dir" ]; then
        log "Wiping ${dir}..."
        i=0
        while [ $i -lt "$PASSES" ]; do
            find "$dir" -type f -exec sh -c '
                sz=$(stat -c%s "$1" 2>/dev/null || echo 0)
                [ "$sz" -gt 0 ] && dd if=/dev/zero of="$1" bs=4096 count=$(( (sz + 4095) / 4096 )) conv=notrunc 2>/dev/null || true
            ' _ {} \;
            i=$((i + 1))
        done
        find "$dir" -delete 2>/dev/null || true
    fi
done

# Wipe bash history, SSH keys, and temp credentials in new root
# FIX(MEDIUM): "for path in $sensitive" with unquoted globs like /home/*/.ssh
# would only expand if files exist; if none matched the literal string would be
# used as a path.  Now we use find to enumerate actual matches safely.
wipe_path() {
    local target="$1"
    [ -e "$target" ] || return 0
    log "Wiping ${target}..."
    if [ -f "$target" ]; then
        # FIND-18 FIX: use shred only if available; always dd as fallback
        if [ "$HAVE_SHRED" = "1" ]; then
            shred -vzn "$PASSES" "$target" 2>/dev/null || true
        fi
        dd if=/dev/zero of="$target" bs=4096 2>/dev/null || true
        rm -f "$target"
    elif [ -d "$target" ]; then
        if [ "$HAVE_SHRED" = "1" ]; then
            find "$target" -type f -exec shred -vzn "$PASSES" {} \; 2>/dev/null || true
        else
            find "$target" -type f -exec sh -c \
                'dd if=/dev/zero of="$1" bs=4096 2>/dev/null || true' _ {} \; 2>/dev/null || true
        fi
        rm -rf "$target"
    fi
}

wipe_path /root/.bash_history
wipe_path /root/.zsh_history
wipe_path /root/.python_history
wipe_path /root/.ssh
wipe_path /tmp
wipe_path /var/tmp
wipe_path /run/user
wipe_path /etc/NetworkManager/system-connections

# BUG-20 FIX: Previous wipe list omitted several high-value credential stores:
#   - ~/.gnupg/        (GPG private keys, keyrings)
#   - ~/.config/       (app configs that may store credentials, tokens)
#   - ~/.local/share/keyrings/  (GNOME keyring — passwords, certs)
#   - ~/.mozilla/      (Firefox: saved passwords, session cookies, history)
#   - ~/.config/chromium/ (Chromium: same)
#   - /root/.netrc, /root/.pgpass  (plaintext credential files)
wipe_path /root/.gnupg
wipe_path /root/.netrc
wipe_path /root/.pgpass
wipe_path /root/.aws
wipe_path /root/.azure
wipe_path /root/.config
wipe_path /root/.local/share/keyrings
wipe_path /root/.mozilla
wipe_path /root/.config/chromium
wipe_path /root/.config/google-chrome

# Glob expansions for per-user files — explicit find to avoid literal string fallback
find /home -maxdepth 2 \( \
    -name '.bash_history' -o \
    -name '.zsh_history' -o \
    -name '.python_history' -o \
    -name '.netrc' -o \
    -name '.pgpass' \
\) 2>/dev/null | while IFS= read -r f; do wipe_path "$f"; done

find /home -maxdepth 2 -type d \( \
    -name '.ssh' -o \
    -name '.gnupg' -o \
    -name '.aws' -o \
    -name '.azure' \
\) 2>/dev/null | while IFS= read -r d; do wipe_path "$d"; done

find /home -maxdepth 3 -type d \( \
    -name 'keyrings' -o \
    -name '.mozilla' -o \
    -name 'chromium' -o \
    -name 'google-chrome' \
\) 2>/dev/null | while IFS= read -r d; do wipe_path "$d"; done

log "Wipe complete. All session data destroyed."
sync
WIPE_EOF
chmod 700 "$WIPE_SCRIPT"

# Install systemd service if systemd will be pid1
if [ -d "${NEWROOT}/lib/systemd" ] || [ -d "${NEWROOT}/usr/lib/systemd" ]; then
    SYSTEMD_UNIT_DIR="${NEWROOT}/etc/systemd/system"
    mkdir -p "$SYSTEMD_UNIT_DIR"

    cat > "${SYSTEMD_UNIT_DIR}/amnesiac-wipe.service" << 'UNIT_EOF'
[Unit]
Description=Amnesiac Secure RAM Wipe
DefaultDependencies=no
Before=shutdown.target reboot.target halt.target
RequiresMountsFor=/

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/amnesiac-wipe
# BUG-22 FIX: 120s (2 min) is insufficient for sessions with many/large files.
# The wipe is a multi-pass shred over ALL tmpfs contents — easily 5-15 min on a
# session with gigabytes of tool output, downloads, or captured data.  Killing
# the wipe early leaves sensitive data un-wiped at shutdown.  Use 'infinity' to
# ensure the wipe always completes regardless of session size.
TimeoutStartSec=infinity
RemainAfterExit=yes

[Install]
WantedBy=halt.target reboot.target shutdown.target
UNIT_EOF

    mkdir -p "${SYSTEMD_UNIT_DIR}/halt.target.wants" \
             "${SYSTEMD_UNIT_DIR}/reboot.target.wants" \
             "${SYSTEMD_UNIT_DIR}/shutdown.target.wants"

    for target in halt reboot shutdown; do
        ln -sf "/etc/systemd/system/amnesiac-wipe.service" \
            "${SYSTEMD_UNIT_DIR}/${target}.target.wants/amnesiac-wipe.service"
    done
fi

# ---------------------------------------------------------------------------
# Switch root
# ---------------------------------------------------------------------------
log "Switching root to overlay — boot complete"
log "ALL writes are volatile and will be wiped on shutdown"
echo ""
echo "  ██████╗  █████╗ ███╗   ███╗     ██████╗ ███████╗"
echo "  ██╔══██╗██╔══██╗████╗ ████║    ██╔═══██╗██╔════╝"
echo "  ██████╔╝███████║██╔████╔██║    ██║   ██║███████╗"
echo "  ██╔══██╗██╔══██║██║╚██╔╝██║    ██║   ██║╚════██║"
echo "  ██║  ██║██║  ██║██║ ╚═╝ ██║    ╚██████╔╝███████║"
echo "  ╚═╝  ╚═╝╚═╝  ╚═╝╚═╝     ╚═╝     ╚═════╝ ╚══════╝"
echo ""
echo "  HARDENED AMNESIAC RAM-OS  |  No persistence"
echo "  All data destroyed on shutdown / power loss"
echo ""

exec switch_root "$NEWROOT" /sbin/init "$@"
