  nmap -p- --min-rate 5000 -oA full <ip>        # All ports fast
  nmap -sU -top-ports 20 <ip>                   # Top 20 UDP
  nmap -sC -sV -p <ports> -oA targeted <ip>     # Targeted with found ports

VULN SCRIPTS
  nmap --script vuln <ip>
