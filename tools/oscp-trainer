# ---------------------------------------------------------------------------
# Main entry point
# ---------------------------------------------------------------------------
main() {
  init_data_dir

  local command="${1:-help}"
  shift || true

  case "${command}" in
    progress)    cmd_progress "$@" ;;
    cheatsheet)  cmd_cheatsheet "$@" ;;
    note)        cmd_note "$@" ;;
    tools)       cmd_tools "$@" ;;
    bookmark)    cmd_bookmark "$@" ;;
    lab)         cmd_lab "$@" ;;
    wordlist)    cmd_wordlist ;;
    report)      cmd_report ;;
    osec3)       cmd_osec3 ;;
    version)     echo "${SCRIPT_NAME} v${VERSION}" ;;
    help|--help|-h) show_usage ;;
    *)
      error "Unknown command: ${command}"
      show_usage
      exit 1
      ;;
  esac
}

main "$@"
