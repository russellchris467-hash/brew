// Arch Linux devcontainer for Homebrew development with Claude Code.
// For format details, see https://aka.ms/devcontainer.json.
//
// Usage with UTM:
//   1. Run setup-arch-vm.sh on a fresh Arch Linux VM, OR
//   2. Use this devcontainer with VS Code / Claude Code:
//      - Open this folder in VS Code with the Dev Containers extension
//      - Select "Arch Linux" configuration when prompted
{
  "name": "Homebrew/brew (Arch Linux)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "../.."
  },
  "workspaceFolder": "/home/linuxbrew/.linuxbrew/Homebrew",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/linuxbrew/.linuxbrew/Homebrew,type=bind,consistency=cached",
  "onCreateCommand": ".devcontainer/arch-linux/on-create-command.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "sorbet.sorbet-vscode-extension",
        "github.vscode-github-actions",
        "anykeyh.simplecov-vscode",
        "ms-azuretools.vscode-docker",
        "github.vscode-pull-request-github",
        "davidanson.vscode-markdownlint",
        "foxundermoon.shell-format",
        "timonwong.shellcheck",
        "ban.spellright",
        "redhat.vscode-yaml",
        "koichisasada.vscode-rdbg",
        "editorconfig.editorconfig"
      ]
    }
  },
  "remoteEnv": {
    "HOMEBREW_GITHUB_API_TOKEN": "${localEnv:GITHUB_TOKEN}"
  }
}
