# =============================================================================
# Hardened RAM-OS Kernel Configuration
# Target: Security-hardened, amnesiac live system
# Based on: Linux 6.6.x LTS
# =============================================================================

# ---------------------------------------------------------------------------
# Core system
# ---------------------------------------------------------------------------
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=256
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_POSIX_MQUEUE=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# ---------------------------------------------------------------------------
# Processor features & mitigations (Spectre / Meltdown / MDS / etc.)
# ---------------------------------------------------------------------------
CONFIG_RETPOLINE=y
CONFIG_PAGE_TABLE_ISOLATION=y
CONFIG_SPECULATION_MITIGATIONS=y
CONFIG_SPECTRE_V1_MITIGATION=y
CONFIG_SPECTRE_V2_MITIGATION=y
CONFIG_SPECTRE_V2_USER_MITIGATION=y
CONFIG_SPEC_STORE_BYPASS_DISABLE=y
CONFIG_X86_MDS_DEFAULT=y
CONFIG_X86_UMIP=y
CONFIG_X86_SMEP=y
CONFIG_X86_SMAP=y
CONFIG_X86_PKU=y
CONFIG_CPU_MITIGATIONS=y
CONFIG_MICROCODE=y
CONFIG_MICROCODE_INTEL=y
CONFIG_MICROCODE_AMD=y

# ---------------------------------------------------------------------------
# Memory layout & ASLR hardening
# ---------------------------------------------------------------------------
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_PHYSICAL_START=0x1000000
CONFIG_PHYSICAL_ALIGN=0x200000
CONFIG_ARCH_MMAP_RND_BITS=32
CONFIG_ARCH_MMAP_RND_COMPAT_BITS=16
CONFIG_VMAP_STACK=y
CONFIG_THREAD_INFO_IN_TASK=y

# ---------------------------------------------------------------------------
# Stack & heap protections
# ---------------------------------------------------------------------------
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_GCC_PLUGIN_STACKLEAK=y
CONFIG_GCC_PLUGIN_STACKLEAK_TRACK_MIN_SIZE=100

# ---------------------------------------------------------------------------
# Memory hardening
# ---------------------------------------------------------------------------
CONFIG_HARDENED_USERCOPY=y
CONFIG_HARDENED_USERCOPY_FALLBACK=n
CONFIG_FORTIFY_SOURCE=y
CONFIG_UBSAN=y
CONFIG_UBSAN_SANITIZE_ALL=y
CONFIG_UBSAN_TRAP=y
CONFIG_UBSAN_NO_ALIGNMENT=n
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLUB_DEBUG=y
CONFIG_PAGE_POISONING=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_ZERO_CALL_USED_REGS=y

# ---------------------------------------------------------------------------
# Kernel image integrity
# ---------------------------------------------------------------------------
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_MODULES_LOCKDOWN=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_SRCVERSION_ALL=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y

# ---------------------------------------------------------------------------
# Restrict kernel information leaks
# ---------------------------------------------------------------------------
CONFIG_PROC_KCORE=n
CONFIG_DEVMEM=n
CONFIG_DEVKMEM=n
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n
CONFIG_HIBERNATION=n
CONFIG_ACPI_CUSTOM_METHOD=n
CONFIG_CHECKPOINT_RESTORE=n
CONFIG_KALLSYMS=n
CONFIG_KALLSYMS_ALL=n
CONFIG_MAGIC_SYSRQ=n
CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_X86_VSYSCALL_EMULATION=n

# ---------------------------------------------------------------------------
# LSM (Linux Security Modules)
# ---------------------------------------------------------------------------
CONFIG_LSM="lockdown,yama,loadpin,safesetid,selinux,apparmor,bpf"
CONFIG_SECURITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_YAMA_STACKED=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=1
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=n
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECURITY_SAFESETID=y
CONFIG_SECURITY_LOADPIN=y
CONFIG_SECURITY_LOADPIN_ENFORCE=y
CONFIG_BPF_LSM=y
CONFIG_INTEGRITY=y
CONFIG_IMA=y
CONFIG_IMA_DEFAULT_HASH_SHA256=y
CONFIG_IMA_APPRAISE=y
CONFIG_IMA_APPRAISE_BOOTPARAM=n

# ---------------------------------------------------------------------------
# seccomp & namespaces
# ---------------------------------------------------------------------------
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_CGROUP_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SECCOMP=y

# ---------------------------------------------------------------------------
# Network hardening
# ---------------------------------------------------------------------------
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_SYN_COOKIES=y
CONFIG_TCP_SYNCOOKIES=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_NFSD=n
CONFIG_IP_DCCP=n
CONFIG_IP_SCTP=n
CONFIG_RDS=n
CONFIG_TIPC=n
CONFIG_ATM=n
CONFIG_DECNET=n
CONFIG_ECONET=n
CONFIG_WAN_ROUTER=n
CONFIG_NET_DIVERT=n
CONFIG_IPX=n
CONFIG_APPLETALK=n
CONFIG_DEV_APPLETALK=n
CONFIG_NETROM=n
CONFIG_AX25=n
CONFIG_ROSE=n
CONFIG_X25=n
CONFIG_LAPB=n
CONFIG_PHONET=n
CONFIG_6LOWPAN=n
CONFIG_NET_9P=y
CONFIG_VSOCKMON=n
CONFIG_PACKET_DIAG=n
CONFIG_UNIX_DIAG=n
# Prevent arbitrary code loading via BPF JIT (allow but harden)
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y

# Wireless tools (Kali requirement)
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_MAC80211_MESH=y
CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_IWLWIFI=y
CONFIG_ATH9K=y
CONFIG_ATH9K_HTC=y
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y
CONFIG_RT2800USB=y
CONFIG_RT2800PCI=y
CONFIG_RTL8187=y
CONFIG_RTL8192CU=y
CONFIG_RTL8192EU=y
CONFIG_RTL8XXXU=y
CONFIG_CARL9170=y
CONFIG_USB_NET_RNDIS_WLAN=y
# Packet injection support
CONFIG_MAC80211_MONITOR=y
CONFIG_CFG80211_WEXT=y
CONFIG_WIRELESS_EXT=y
CONFIG_WEXT_CORE=y
CONFIG_WEXT_PROC=y

# Bluetooth
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIUSB=y

# ---------------------------------------------------------------------------
# Filesystems (RAM-only focus)
# ---------------------------------------------------------------------------
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAYFS_REDIRECT_ALWAYS_FOLLOW=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_RAMFS=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_INITRAMFS_COMPRESSION_ZSTD=y
# ext4 (needed for USB boot media - read only)
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
# vfat for EFI
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
# ISO9660 for CD boot
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
# Disable persistent storage filesystems (reduce attack surface)
CONFIG_BTRFS_FS=n
CONFIG_XFS_FS=n
CONFIG_JFS_FS=n
CONFIG_REISERFS_FS=n
CONFIG_GFS2_FS=n
CONFIG_CIFS=n
CONFIG_NFS_FS=n
CONFIG_NFSD=n

# ---------------------------------------------------------------------------
# Block & storage (minimal — system lives in RAM)
# ---------------------------------------------------------------------------
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=16
CONFIG_BLK_DEV_RAM_SIZE=65536
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSMALLOC=y
# SCSI/USB storage (for boot device detection only)
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_PATA_ACPI=y
CONFIG_ATA_PIIX=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
# Disable swap entirely (amnesiac requirement)
CONFIG_SWAP=n
CONFIG_MEMCG_SWAP=n

# ---------------------------------------------------------------------------
# Cryptography (strong defaults)
# ---------------------------------------------------------------------------
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_AES_X86_64=y
CONFIG_CRYPTO_CHACHA20_X86_64=y
CONFIG_CRYPTO_POLY1305_X86_64=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_SHA3=y
CONFIG_CRYPTO_BLAKE2B=y
CONFIG_CRYPTO_BLAKE2S_X86=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_DRBG_HMAC=y
CONFIG_CRYPTO_DRBG_CTR=y
CONFIG_CRYPTO_JITTERENTROPY=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_INTEL=y
CONFIG_HW_RANDOM_AMD=y
CONFIG_HW_RANDOM_VIA=y
CONFIG_CRYPTO_DEV_PADLOCK_SHA=y
CONFIG_CRYPTO_DEV_PADLOCK_AES=y
CONFIG_CRYPTO_DM_INTEGRITY=y
CONFIG_DM_CRYPT=y

# ---------------------------------------------------------------------------
# USB & hardware
# ---------------------------------------------------------------------------
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT_EVDEV=y

# Disable dangerous USB device classes (attack surface reduction)
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_ACM=y

# ---------------------------------------------------------------------------
# Virtualization support (optional, for running in VMs)
# ---------------------------------------------------------------------------
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
# FIX(MEDIUM): Balloon driver disabled. With it enabled, the VM hypervisor can
# request RAM pages back from the guest at any time, potentially reading volatile
# session data (keys, decrypted secrets) that the OS has not yet zeroed out.
# This defeats the amnesiac guarantee when running inside a VM.
CONFIG_VIRTIO_BALLOON=n

# ---------------------------------------------------------------------------
# Printk / debugging (stripped for release)
# ---------------------------------------------------------------------------
CONFIG_PRINTK=y
CONFIG_DYNAMIC_DEBUG=n
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n
CONFIG_KGDB=n
CONFIG_KPROBES=n
CONFIG_FTRACE=n
CONFIG_TRACING=n
CONFIG_EARLY_PRINTK=y
CONFIG_CMDLINE_BOOL=n
